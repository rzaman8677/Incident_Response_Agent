# Agent backend: auto | openai | deterministic
# auto uses OpenAI when OPENAI_API_KEY is present, otherwise deterministic reasoning.
SENTINELOPS_AGENT_BACKEND=auto
SENTINELOPS_MODEL=gpt-5-mini
SENTINELOPS_LLM_FALLBACK=true
SENTINELOPS_LLM_TIMEOUT_SECONDS=30

# OpenAI Responses API credential. Never commit a real key.
OPENAI_API_KEY=

# Runtime policy: observe | assisted | autonomous
SENTINELOPS_AUTONOMY=assisted
SENTINELOPS_CONFIDENCE_THRESHOLD=0.82
SENTINELOPS_MAX_BLAST_RADIUS=2
SENTINELOPS_ACTION_BUDGET=4

# Infrastructure: simulator | aws_ecs | gcp_cloud_run | kubernetes
SENTINELOPS_INFRA_BACKEND=simulator
SENTINELOPS_TELEMETRY_LOOKBACK_MINUTES=15

# Durable state: memory | firestore
SENTINELOPS_STATE_BACKEND=memory
SENTINELOPS_FIRESTORE_DATABASE=(default)
SENTINELOPS_FIRESTORE_COLLECTION_PREFIX=sentinelops

# AWS ECS + CloudWatch. Use workload credentials; do not store AWS keys here.
SENTINELOPS_AWS_REGION=us-east-1
SENTINELOPS_AWS_ECS_CLUSTER=
SENTINELOPS_AWS_LOG_GROUP_TEMPLATE=/aws/ecs/{service}
SENTINELOPS_AWS_METRIC_NAMESPACE=SentinelOps/Services

# GCP Cloud Run + Cloud Logging/Monitoring + Firestore.
SENTINELOPS_GCP_PROJECT=
SENTINELOPS_GCP_REGION=
SENTINELOPS_GCP_METRIC_ERROR_RATE=custom.googleapis.com/sentinelops/error_rate
SENTINELOPS_GCP_METRIC_P95_LATENCY_MS=custom.googleapis.com/sentinelops/p95_latency_ms
SENTINELOPS_GCP_METRIC_CPU_PERCENT=custom.googleapis.com/sentinelops/cpu_percent

# Kubernetes, including EKS/GKE when their API credentials are configured.
SENTINELOPS_K8S_NAMESPACE=default
SENTINELOPS_K8S_LABEL_KEY=app.kubernetes.io/name
SENTINELOPS_K8S_CONTEXT=
